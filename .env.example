# =====================================================
# Maaperä.fi — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to git.
# =====================================================

# -----------------------------------------------------
# Supabase
# Get from: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJ...                  # public, safe in frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server-only, NEVER expose
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_DB_PASSWORD=                     # for direct psql access

# Frontend equivalents (Vite reads VITE_ prefix only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# -----------------------------------------------------
# Copernicus / EGMS
# Register: https://land.copernicus.eu/
# -----------------------------------------------------
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# -----------------------------------------------------
# Cloudflare R2 (Parquet time-series storage)
# Get from: https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# -----------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=maapera-timeseries
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# -----------------------------------------------------
# Stripe
# Get from: https://dashboard.stripe.com/test/apikeys
# -----------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Pricing IDs (create in Stripe dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_OFFICE_MONTHLY=price_...
STRIPE_PRICE_OFFICE_YEARLY=price_...

# -----------------------------------------------------
# Email (for alerts and reports)
# Resend recommended: https://resend.com
# -----------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=Maaperä.fi <noreply@your-domain.fi>
EMAIL_REPLY_TO=tuki@your-domain.fi

# -----------------------------------------------------
# Anthropic (for any AI-powered interpretation features)
# Optional in MVP — rule-based interpretation is the default
# -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------
# Analytics
# -----------------------------------------------------
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://eu.posthog.com

# -----------------------------------------------------
# App config
# -----------------------------------------------------
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173/api
APP_ENV=development                       # development | staging | production

# -----------------------------------------------------
# MML (Maanmittauslaitos) — optional API access
# Open data is also available as bulk download without auth
# https://www.maanmittauslaitos.fi/rajapinnat/api-avaimen-ohje
# -----------------------------------------------------
MML_API_KEY=
